# Copy to .env.local and fill in real values. Never commit .env.local.

# Web push VAPID keys — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push service admins (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com

# OpenAI (server-side only)
OPENAI_API_KEY=

# Your own backend API (Arnold Nutrition & Fitness API)
# e.g. https://mcp-production-c11b.up.railway.app/arnold
API_BASE_URL=

# Upstash Redis (Vercel Marketplace) — backs chat, dashboard cards, the
# assistant prompt, and push subscriptions. Same instance for local dev and prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
